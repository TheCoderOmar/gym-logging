<%- include('partials/head') %>
<div class="page page-narrow">
  <div class="page-head"><h1>Settings</h1></div>

  <form method="post" action="/settings">
    <div class="setting">
      <div>
        <h3>Show weights in</h3>
        <p>Used for totals, charts and records. Each exercise in the logger still has its own kg/lb switch, so you can log a lb machine and kg dumbbells in the same workout.</p>
      </div>
      <div class="seg" role="radiogroup" aria-label="Display unit">
        <label><input type="radio" name="display_unit" value="kg" <%= unit === 'kg' ? 'checked' : '' %>><span>kg</span></label>
        <label><input type="radio" name="display_unit" value="lb" <%= unit === 'lb' ? 'checked' : '' %>><span>lb</span></label>
      </div>
    </div>
    <div class="setting">
      <div>
        <h3>Barbell weight</h3>
        <p>Used by the plate calculator in the logger.</p>
      </div>
      <div class="btn-row" style="flex-wrap:nowrap">
        <label class="sr-only" for="bar_kg">Bar weight in kg</label>
        <input id="bar_kg" type="number" name="bar_kg" step="0.5" min="0" max="50" value="<%= bar.kg %>" style="width:84px"> <span class="muted">kg</span>
        <label class="sr-only" for="bar_lb">Bar weight in lb</label>
        <input id="bar_lb" type="number" name="bar_lb" step="1" min="0" max="110" value="<%= bar.lb %>" style="width:84px"> <span class="muted">lb</span>
      </div>
    </div>
    <div class="setting">
      <div>
        <h3>Theme</h3>
        <p>Follows your system unless you pick one here. Saved in this browser.</p>
      </div>
      <div class="seg" role="radiogroup" aria-label="Theme" id="theme-seg">
        <label><input type="radio" name="theme" value=""><span>System</span></label>
        <label><input type="radio" name="theme" value="light"><span>Light</span></label>
        <label><input type="radio" name="theme" value="dark"><span>Dark</span></label>
      </div>
    </div>
    <div class="btn-row" style="margin-top:20px"><button class="btn btn-go">Save settings</button></div>
  </form>

  <section class="section">
    <h2 style="margin-bottom:6px">Your data</h2>
    <p class="muted" style="margin-bottom:16px">
      Everything is stored in <code>db/gym.sqlite</code> on this computer:
      <%= fmt.num(counts.exercises) %> exercises (<%= counts.custom %> yours), <%= counts.routines %> routines,
      <%= counts.workouts %> workouts and <%= fmt.num(counts.sets) %> sets.
    </p>
    <a class="btn" href="/settings/backup"><%- icon('download') %> Download backup</a>
    <p class="muted small" style="margin-top:8px">A complete copy of the database, media included (~150 MB). To restore, stop the app and replace <code>db/gym.sqlite</code> with it.</p>
  </section>
</div>
<script>
  (() => {
    const seg = document.getElementById('theme-seg');
    let current = '';
    try { current = localStorage.getItem('theme') || ''; } catch (e) {}
    seg.querySelector(`input[value="${current}"]`).checked = true;
    seg.addEventListener('change', (e) => {
      const v = e.target.value;
      try { v ? localStorage.setItem('theme', v) : localStorage.removeItem('theme'); } catch (err) {}
      if (v) document.documentElement.dataset.theme = v;
      else delete document.documentElement.dataset.theme;
    });
  })();
</script>
<%- include('partials/foot') %>
