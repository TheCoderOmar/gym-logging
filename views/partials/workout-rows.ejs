<ul class="rows">
  <% for (const w of rows) { %>
    <li>
      <a class="row-link history-row" href="/workouts/<%= w.id %>">
        <span class="when"><%= fmt.relDay(w.started_at) %><small><%= fmt.relDay(w.started_at) === fmt.date(w.started_at) ? fmt.weekday(w.started_at).slice(0, 3) : fmt.date(w.started_at) %></small></span>
        <span class="what">
          <strong><%= w.name %></strong>
          <p><%= w.exercise_names || 'No exercises' %></p>
        </span>
        <span class="figures">
          <span class="num"><%= fmt.num(w.volume) %> <%= unit %></span>
          <%= w.set_count %> <%= w.set_count === 1 ? 'set' : 'sets' %>
        </span>
      </a>
    </li>
  <% } %>
</ul>
