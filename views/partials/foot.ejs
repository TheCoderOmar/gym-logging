  </main>
  <nav class="tabbar" aria-label="Main">
    <a href="/" <%- active('/') ? 'aria-current="page"' : '' %>><%- icon('home') %>Home</a>
    <a href="/workouts" <%- active('/workouts') ? 'aria-current="page"' : '' %>><%- icon('history') %>History</a>
    <a href="/exercises" <%- active('/exercises') ? 'aria-current="page"' : '' %>><%- icon('library') %>Exercises</a>
    <a href="/routines" <%- active('/routines') ? 'aria-current="page"' : '' %>><%- icon('routines') %>Routines</a>
    <a href="/progress" <%- active('/progress') ? 'aria-current="page"' : '' %>><%- icon('progress') %>Progress</a>
  </nav>
  <% if (live && path !== '/' && !path.startsWith('/workouts/' + live.id + '/log')) { %>
    <a class="live-strip" href="/workouts/<%= live.id %>/log"><span>Back to <%= live.name %></span><span>Started <%= fmt.time(live.started_at) %></span></a>
  <% } %>
</div>
<script src="/js/confirm.js"></script>
<% if (typeof scripts !== 'undefined') { for (const s of scripts) { %><script src="<%= s %>"></script>
<% } } %>
</body>
</html>
