<section class="section panel log-panel" id="training-log" aria-labelledby="log-title">
  <div class="panel-head log-head-row">
    <div>
      <h2 id="log-title">Training log</h2>
      <p class="muted small"><%= activeDays %> training <%= activeDays === 1 ? 'day' : 'days' %> in <%= year %></p>
    </div>
    <nav class="year-nav" aria-label="Year">
      <% if (prevYear) { %><a class="btn btn-sm btn-quiet" href="/?year=<%= prevYear %>#training-log" data-year="<%= prevYear %>" aria-label="Previous year"><%- icon('left') %></a><% } else { %><span class="btn btn-sm btn-quiet" aria-hidden="true" style="visibility:hidden"><%- icon('left') %></span><% } %>
      <b class="num"><%= year %></b>
      <% if (nextYear) { %><a class="btn btn-sm btn-quiet" href="/?year=<%= nextYear %>#training-log" data-year="<%= nextYear %>" aria-label="Next year"><%- icon('right') %></a><% } else { %><span class="btn btn-sm btn-quiet" aria-hidden="true" style="visibility:hidden"><%- icon('left') %></span><% } %>
    </nav>
    <div class="chart-tabs" role="group" aria-label="Training log view">
      <button type="button" data-cal-view="levels" aria-pressed="true">Exercises</button>
      <button type="button" data-cal-view="emoji" aria-pressed="false">Emoji</button>
    </div>
  </div>

  <div class="cal-scroll" id="cal-scroll">
    <div class="cal" id="cal" data-view="levels" style="--weeks: <%= weeks %>">
      <div class="cal-months" aria-hidden="true">
        <% for (const m of months) { %><span style="grid-column: <%= m.col + 1 %>"><%= m.label %></span><% } %>
      </div>
      <div class="cal-days" aria-hidden="true"><span>Sat</span><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span></div>
      <div class="cal-grid" role="list">
        <% for (const d of days) {
             const label = fmt.date(d.date.toISOString(), { weekday: 'short', year: 'numeric' }) + ': ' + (d.exercises ? d.exercises + (d.exercises === 1 ? ' exercise' : ' exercises') + ', ' + d.sets + ' sets · ' + d.areas.join(', ') : 'rest day');
        %><% if (d.outside) { %><span class="cell out" aria-hidden="true"></span><% } else if (d.future) { %><span class="cell l0 future" aria-hidden="true"></span><% } else if (d.workoutId || d.sportId) { %><a role="listitem" data-level="<%= d.level %>" data-areas="<%= d.areaKeys.join(' ') %>" class="cell l<%= d.level %><%= d.today ? ' is-today' : '' %>" href="<%= d.workoutId ? '/workouts/' + d.workoutId : '/sports/' + d.sportId %>" title="<%= label %>" aria-label="<%= label %>"><span class="emo"><%= d.emoji %></span></a><% } else { %><span role="listitem" class="cell l0<%= d.today ? ' is-today' : '' %>" title="<%= label %>"></span><% } %><% } %>
      </div>
    </div>
  </div>

  <div class="cal-legend" role="group" aria-label="Filter the training log">
    <div class="legend-levels">
      <span class="muted small">Exercises per day</span>
      <% [['1–3', 1], ['4', 2], ['5', 3], ['6', 4], ['7+', 5]].forEach(([t, l]) => { %><button type="button" class="lv" data-filter-level="<%= l %>" aria-pressed="false"><span class="cell l<%= l %>"></span><%= t %></button><% }) %>
    </div>
    <div class="legend-emoji">
      <% for (const k of emojiKey) { %><button type="button" class="lv" data-filter-area="<%= k.key %>" aria-pressed="false"><span class="emo-k"><%= k.emoji %></span><%= k.label %></button><% } %>
    </div>
    <div class="filter-status" hidden>
      <span class="muted small" id="filter-count" aria-live="polite"></span>
      <button type="button" class="btn btn-sm btn-quiet" id="filter-clear">Clear filter</button>
    </div>
  </div>
</section>
